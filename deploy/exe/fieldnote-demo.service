# Dedicated anonymous sandbox; do not replace the private fieldnote service.
# Provision the fluidforms-demo user, source directory, and private environment.
[Unit]
Description=Fluid Forms isolated public sandbox
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fluidforms-demo
Group=fluidforms-demo
WorkingDirectory=/opt/fluid-forms-demo
EnvironmentFile=/etc/fieldnote-demo/fieldnote.env
Environment=PYTHONUNBUFFERED=1
StateDirectory=fluidforms-demo
StateDirectoryMode=0700
ExecStart=/opt/fluid-forms-demo/.venv/bin/python /opt/fluid-forms-demo/scripts/serve.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
