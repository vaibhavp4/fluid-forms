# Prepared for an exe.dev VM; not installed or deployed.
# Provision the fieldnote user and /opt/fluid-forms before installing this unit.
[Unit]
Description=Fieldnote adaptive site updates
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fieldnote
Group=fieldnote
WorkingDirectory=/opt/fluid-forms
EnvironmentFile=/etc/fieldnote/fieldnote.env
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE_URL=sqlite:////var/lib/fieldnote/fieldnote.db
Environment=MEDIA_DIR=/var/lib/fieldnote/media
StateDirectory=fieldnote
StateDirectoryMode=0700
ExecStart=/opt/fluid-forms/.venv/bin/python /opt/fluid-forms/scripts/serve.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
