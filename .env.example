# Copy to .env. Never commit real keys.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Verified NVIDIA vision model. Clear this value for human-review-only evidence.
VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# Defaults to Nebius credentials/URL unless explicitly supplied.
VISION_API_KEY=
VISION_BASE_URL=
# Local persistent SQLite by default; Neon uses postgresql+psycopg://...
DATABASE_URL=sqlite:///.data/fieldnote.db
# Required if exposing beyond localhost; owner API uses this bearer token.
OWNER_TOKEN=
